# ── Polymarket Smart Hybrid Trading Bot v2.4 — environment template ──
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#   cp .env.example .env

# ── Polymarket (leave blank to stay in PAPER mode) ──
# Both must be set to enable REAL trading via the CLOB client.
POLYGON_WALLET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# ── News / Sentiment APIs (optional) ──
# GNews free tier = 100 requests/day. When exhausted the bot calls HuggingFace directly.
GNEWS_API_KEY=
HUGGINGFACE_API_KEY=

# ── Telegram notifications (optional, 2-way) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Dashboard / Flask ──
# If FLASK_SECRET_KEY is unset a random one is generated each start (logs out sessions on restart).
FLASK_SECRET_KEY=
ADMIN_PASSWORD=admin1234
